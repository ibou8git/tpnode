<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  
    <main>
        <h1>FAQ - Questions Fréquemment Posées</h1>
        <ul>
            <% faqs.forEach(faq => { %>
                <li>
                    <strong><%= faq.question %></strong>
                    <p><%= faq.answer %></p>
                </li>
            <% }); %>
        </ul>
    </main>
</body>
</html>